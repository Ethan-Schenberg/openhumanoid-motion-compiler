{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhumanoid.dev/schemas/simulation-bundle-v0.1.schema.json",
  "title": "OHMC simulation evidence bundle manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "fidelity",
    "result",
    "capabilities",
    "inputs",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "schema": { "const": "ohmc.simulation_bundle/v0.1" },
    "target": { "type": "string", "minLength": 1 },
    "fidelity": {
      "enum": ["synthetic_contract_fixture", "official_vendor_model"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay",
        "motion_validation",
        "motion_quality",
        "landmark_coverage",
        "ik",
        "hardware_commands_sent"
      ],
      "properties": {
        "replay": { "const": "pass" },
        "motion_validation": { "enum": ["pass", "warning", "fail"] },
        "motion_quality": { "enum": ["pass", "warning"] },
        "landmark_coverage": { "enum": ["pass", "warning"] },
        "ik": { "enum": ["not_run", "pass"] },
        "hardware_commands_sent": { "const": false }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_joint_mapping",
        "canonical_source_kinematics",
        "morphology_scaling",
        "canonical_timeline_resampling",
        "trajectory_derivatives",
        "mapping_completeness_report",
        "landmark_coverage_report",
        "headless_kinematic_replay",
        "vendor_interface_fixture",
        "constrained_partial_body_ik",
        "constrained_whole_body_ik",
        "dynamic_controller_simulation",
        "hardware_transport"
      ],
      "properties": {
        "canonical_source_kinematics": { "type": "boolean" },
        "morphology_scaling": { "type": "boolean" },
        "canonical_timeline_resampling": { "type": "boolean" },
        "trajectory_derivatives": { "type": "boolean" },
        "mapping_completeness_report": { "type": "boolean" },
        "landmark_coverage_report": { "type": "boolean" },
        "semantic_joint_mapping": { "type": "boolean" },
        "headless_kinematic_replay": { "type": "boolean" },
        "vendor_interface_fixture": { "type": "boolean" },
        "constrained_partial_body_ik": { "type": "boolean" },
        "constrained_whole_body_ik": { "const": false },
        "dynamic_controller_simulation": { "const": false },
        "hardware_transport": { "const": false }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "source_license",
        "source_convention",
        "source_length_unit",
        "morphology_scale",
        "normalization_rate_hz",
        "simulation_model_sha256",
        "target_config_sha256"
      ],
      "properties": {
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_license": { "type": "string", "minLength": 1 },
        "source_convention": { "type": "string", "minLength": 1 },
        "source_length_unit": { "enum": ["m", "cm", "mm"] },
        "morphology_scale": { "type": "number", "exclusiveMinimum": 0 },
        "normalization_rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "simulation_model_sha256": { "$ref": "#/$defs/sha256" },
        "target_config_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_motion",
        "canonical_source",
        "canonical_motion",
        "motion",
        "replay_report",
        "quality_report",
        "landmark_report",
        "interface_fixture",
        "robot_profile",
        "semantic_mapping"
      ],
      "properties": {
        "canonical_source": { "$ref": "#/$defs/artifact" },
        "canonical_motion": { "$ref": "#/$defs/artifact" },
        "source_motion": { "$ref": "#/$defs/artifact" },
        "motion": { "$ref": "#/$defs/artifact" },
        "replay_report": { "$ref": "#/$defs/artifact" },
        "quality_report": { "$ref": "#/$defs/artifact" },
        "landmark_report": { "$ref": "#/$defs/artifact" },
        "interface_fixture": { "$ref": "#/$defs/artifact" },
        "robot_profile": { "$ref": "#/$defs/artifact" },
        "semantic_mapping": { "$ref": "#/$defs/artifact" },
        "ik_task_map": { "$ref": "#/$defs/artifact" },
        "ik_problem": { "$ref": "#/$defs/artifact" },
        "ik_result": { "$ref": "#/$defs/artifact" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "properties": { "ik": { "const": "pass" } },
            "required": ["ik"]
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": { "constrained_partial_body_ik": { "const": true } }
          },
          "artifacts": {
            "required": ["ik_task_map", "ik_problem", "ik_result"]
          }
        }
      },
      "else": {
        "properties": {
          "capabilities": {
            "properties": { "constrained_partial_body_ik": { "const": false } }
          }
        }
      }
    }
  ]
}
