{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhumanoid.dev/schemas/policy-bundle-v0.1.schema.json",
  "title": "OHMC Policy Bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_id", "created_at", "source_run_id", "robot_profile", "training_recipe_sha256", "initialization", "joint_order", "observation", "action", "timing", "perception", "artifacts", "evidence", "authority"],
  "properties": {
    "schema": { "const": "ohmc.policy_bundle/v0.1" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_run_id": { "type": "string", "minLength": 1 },
    "robot_profile": { "type": "string", "minLength": 1 },
    "training_recipe_sha256": { "$ref": "#/$defs/sha256" },
    "initialization": { "const": "random" },
    "joint_order": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observation": { "type": "object" },
    "action": { "type": "object" },
    "timing": { "type": "object" },
    "perception": { "type": "object" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "enum": ["policy_onnx", "checkpoint", "normalization", "camera_calibration", "test_vectors", "evidence"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status"],
      "properties": {
        "level": { "const": "E3_sim2sim" },
        "status": { "const": "pass" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware_execution", "automatic_promotion", "operator_review_required"],
      "properties": {
        "hardware_execution": { "const": false },
        "automatic_promotion": { "const": false },
        "operator_review_required": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
