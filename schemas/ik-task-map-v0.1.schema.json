{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhumanoid.dev/schemas/ik-task-map-v0.1.schema.json",
  "title": "OHMC canonical-to-robot IK task map v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "variables", "tasks", "solver"],
  "properties": {
    "schema": { "const": "ohmc.ik_task_map/v0.1" },
    "id": { "type": "string", "minLength": 1 },
    "variables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_joint",
          "target_frame",
          "weight",
          "tolerance_m",
          "scale"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_joint": { "type": "string", "minLength": 1 },
          "target_frame": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "tolerance_m": { "type": "number", "exclusiveMinimum": 0 },
          "scale": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_iterations",
        "damping",
        "max_step_rad",
        "neutral_weight",
        "temporal_weight"
      ],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1 },
        "damping": { "type": "number", "exclusiveMinimum": 0 },
        "max_step_rad": { "type": "number", "exclusiveMinimum": 0 },
        "neutral_weight": { "type": "number", "minimum": 0 },
        "temporal_weight": { "type": "number", "minimum": 0 }
      }
    }
  }
}
