{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhumanoid.dev/schemas/semantic-map-v0.1.schema.json",
  "title": "OHMC Semantic Joint Map v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "rules"],
  "properties": {
    "schema": { "const": "ohmc.semantic_map/v0.1" },
    "id": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "scale"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "scale": { "type": "number" },
          "offset": { "type": "number", "default": 0 }
        }
      }
    }
  }
}
