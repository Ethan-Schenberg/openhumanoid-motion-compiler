{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhumanoid.dev/schemas/run-manifest-v0.1.schema.json",
  "title": "OHMC Run Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "recipe", "state", "execution", "created_at", "updated_at", "history", "artifacts", "authority"],
  "properties": {
    "schema": { "const": "ohmc.run_manifest/v0.1" },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$" },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "path": { "const": "recipe.yaml" }
      }
    },
    "state": { "enum": ["created", "preflight", "training", "evaluating", "sim2sim", "awaiting_hardware_review", "hardware_candidate", "failed", "cancelled"] },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pid", "last_error"],
      "properties": {
        "status": { "enum": ["idle", "ready", "queued", "running", "paused", "blocked", "complete", "failed", "cancelled"] },
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "last_error": { "type": ["string", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "at", "message"],
        "properties": {
          "state": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware_transport", "automatic_hardware_promotion"],
      "properties": {
        "hardware_transport": { "const": false },
        "automatic_hardware_promotion": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
