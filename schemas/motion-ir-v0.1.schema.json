{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhumanoid.dev/schemas/motion-ir-v0.1.schema.json",
  "title": "OpenHumanoid Motion IR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "robot", "frames", "trajectory", "passes", "validation"],
  "properties": {
    "schema": { "const": "ohmc.motion_ir/v0.1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri-reference" }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "model_sha256"],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "vendor": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["convention", "world", "base"],
      "properties": {
        "convention": { "const": "right_handed_x_forward_y_left_z_up" },
        "world": { "type": "string", "minLength": 1 },
        "base": { "type": "string", "minLength": 1 }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate_hz", "joints", "samples"],
      "properties": {
        "rate_hz": { "type": "number", "exclusiveMinimum": 0 },
        "joints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sample" }
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contact" }
    },
    "passes": {
      "type": "array",
      "items": { "$ref": "#/$defs/pass" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": { "enum": ["pass", "warning", "fail"] },
        "issues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "report": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finiteNumber": { "type": "number" },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "position_targets"],
      "properties": {
        "time": { "type": "number", "minimum": 0 },
        "position_targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "velocity_targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "acceleration_targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/finiteNumber" }
        },
        "solver_status": { "enum": ["solved", "fallback", "failed"] },
        "residual": { "type": "number", "minimum": 0 }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effector", "intervals"],
      "properties": {
        "effector": { "type": "string", "minLength": 1 },
        "intervals": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "number", "minimum": 0 },
              { "type": "number", "minimum": 0 }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "config_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}

