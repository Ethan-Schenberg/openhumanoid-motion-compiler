{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhumanoid.dev/schemas/simulation-matrix-v0.1.schema.json",
  "title": "OHMC isolated simulation target matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "targets",
    "summary",
    "hardware_commands_sent"
  ],
  "properties": {
    "schema": { "const": "ohmc.simulation_matrix/v0.1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "license",
        "convention",
        "length_unit",
        "input_contract"
      ],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "minLength": 1 },
        "convention": { "type": "string", "minLength": 1 },
        "length_unit": { "enum": ["m", "cm", "mm"] },
        "input_contract": {
          "enum": ["simple_motion_v1", "full_body_landmarks_v1"]
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/passedTarget" },
          { "$ref": "#/$defs/failedTarget" }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "target_count", "passed_count", "failed_count"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "target_count": { "type": "integer", "minimum": 1 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 }
      }
    },
    "hardware_commands_sent": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "passedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "status", "bundle", "manifest_sha256"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "status": { "const": "pass" },
        "bundle": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "failedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "status", "error"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "status": { "const": "fail" },
        "error": { "type": "string", "minLength": 1 }
      }
    }
  }
}
