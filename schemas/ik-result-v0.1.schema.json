{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openhumanoid.dev/schemas/ik-result-v0.1.schema.json",
  "title": "OHMC inverse-kinematics result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "problem_sha256",
    "status",
    "variables",
    "frames",
    "summary",
    "hardware_commands_sent"
  ],
  "properties": {
    "schema": { "const": "ohmc.ik_result/v0.1" },
    "problem_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["pass", "fail"] },
    "variables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_count",
        "solved_frame_count",
        "failed_frame_count",
        "peak_residual_m"
      ],
      "properties": {
        "frame_count": { "type": "integer", "minimum": 1 },
        "solved_frame_count": { "type": "integer", "minimum": 0 },
        "failed_frame_count": { "type": "integer", "minimum": 0 },
        "peak_residual_m": { "type": "number", "minimum": 0 }
      }
    },
    "hardware_commands_sent": { "const": false }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "status",
        "iterations",
        "positions",
        "max_residual_m",
        "task_residuals_m",
        "active_joint_limits"
      ],
      "properties": {
        "time": { "type": "number", "minimum": 0 },
        "status": { "enum": ["solved", "failed"] },
        "iterations": { "type": "integer", "minimum": 0 },
        "positions": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "max_residual_m": { "type": "number", "minimum": 0 },
        "task_residuals_m": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "active_joint_limits": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
